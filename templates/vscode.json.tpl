{
  "name": "${name}",
  "version": "${version}",
  "type": "dark",
  "colors": {
    "editor.background": "#${black}",
    "editor.foreground": "#${text_fg}",
    "editor.lineHighlightBackground": "#${bg_caret_row}",
    "editor.selectionBackground": "#${selection_bg}",
    "editor.wordHighlightBackground": "#${id_under_caret_bg}",
    "editor.wordHighlightBorder": "#${id_under_caret_eff}",
    "editor.wordHighlightStrongBackground": "#${id_under_caret_bg}",
    "editor.wordHighlightStrongBorder": "#${write_id_eff}",
    "editor.findMatchBackground": "#${search_bg}",
    "editor.findMatchHighlightBackground": "#${search_bg}99",
    "editor.findMatchBorder": "#${search_eff}",
    "editor.hoverHighlightBackground": "#${bg_hint_border}",
    "editor.foldBackground": "#${bg_indent}40",
    "editor.lineHighlightBorder": "#00000000",
    "editor.rangeHighlightBackground": "#${bg_caret_row}",
    "editor.inlayHint.foreground": "#${inlay}",
    "editor.inlayHint.background": "#00000000",
    "editor.linkedEditingBackground": "#${selection_bg}",

    "editorCursor.foreground": "#${fg0}",
    "editorLineNumber.foreground": "#${gray0}",
    "editorLineNumber.activeForeground": "#${gray1}",
    "editorIndentGuide.background": "#${bg_indent}",
    "editorIndentGuide.activeBackground": "#${bg_hint_border}",
    "editorBracketMatch.background": "#${matched_brace_bg}",
    "editorBracketMatch.border": "#${matched_brace_bg}",
    "editorRuler.foreground": "#${bg_indent}",
    "editorWhitespace.foreground": "#${bg_hint_border}",
    "editorGutter.background": "#${black}",
    "editorGutter.addedBackground": "#${fs_added}",
    "editorGutter.modifiedBackground": "#${fs_modified}",
    "editorGutter.deletedBackground": "#${fs_deleted}",

    "editorError.foreground": "#${red}",
    "editorWarning.foreground": "#${yellow}",
    "editorInfo.foreground": "#${teal_info}",
    "editorHint.foreground": "#${teal_hint}",

    "editorOverviewRuler.errorForeground": "#${red}",
    "editorOverviewRuler.warningForeground": "#${warn_stripe}",
    "editorOverviewRuler.infoForeground": "#${teal_info}",
    "editorOverviewRuler.findMatchForeground": "#${search_stripe}",
    "editorOverviewRuler.wordHighlightForeground": "#${id_under_caret_eff}",

    "diffEditor.insertedTextBackground": "#${diff_inserted_bg}80",
    "diffEditor.removedTextBackground": "#${diff_deleted_bg}80",

    "editorWidget.background": "#${bg_lookup}",
    "editorWidget.border": "#${bg_hint_border}",
    "editorSuggestWidget.background": "#${bg_lookup}",
    "editorSuggestWidget.border": "#${bg_hint_border}",
    "editorSuggestWidget.selectedBackground": "#${bg_hint_border}",
    "editorHoverWidget.background": "#${bg_lookup}",
    "editorHoverWidget.border": "#${bg_hint_border}",

    "debugToolBar.background": "#${bg_lookup}",
    "debugExceptionWidget.background": "#${eval_expr_bg}",
    "debugExceptionWidget.border": "#${red}",

    "focusBorder": "#${variable}",
    "foreground": "#${fg1}",
    "descriptionForeground": "#${gray1}",
    "errorForeground": "#${red}",

    "widget.shadow": "#00000080",
    "input.background": "#${bg_caret_row}",
    "input.foreground": "#${fg1}",
    "input.border": "#${bg_hint_border}",
    "input.placeholderForeground": "#${gray0}",
    "inputOption.activeBorder": "#${variable}",

    "dropdown.background": "#${bg_lookup}",
    "dropdown.border": "#${bg_hint_border}",
    "dropdown.foreground": "#${fg1}",

    "list.activeSelectionBackground": "#${bg_hint_border}",
    "list.activeSelectionForeground": "#${fg0}",
    "list.hoverBackground": "#${bg_indent}",
    "list.focusBackground": "#${bg_hint_border}",
    "list.highlightForeground": "#${selection_fg}",
    "list.errorForeground": "#${red}",
    "list.warningForeground": "#${yellow}",

    "activityBar.background": "#${bg_caret_row}",
    "activityBar.foreground": "#${fg1}",
    "activityBarBadge.background": "#${variable}",
    "activityBarBadge.foreground": "#${fg0}",

    "sideBar.background": "#${bg_caret_row}",
    "sideBar.foreground": "#${fg1}",
    "sideBar.border": "#${bg_indent}",
    "sideBarTitle.foreground": "#${fg0}",
    "sideBarSectionHeader.background": "#${bg_lookup}",
    "sideBarSectionHeader.foreground": "#${fg1}",

    "titleBar.activeBackground": "#${bg_caret_row}",
    "titleBar.activeForeground": "#${fg1}",
    "titleBar.inactiveBackground": "#${bg_caret_row}",
    "titleBar.inactiveForeground": "#${gray0}",

    "statusBar.background": "#${bg_caret_row}",
    "statusBar.foreground": "#${fg1}",
    "statusBar.debuggingBackground": "#${exec_point_bg}",
    "statusBar.noFolderBackground": "#${bg_lookup}",

    "tab.activeBackground": "#${black}",
    "tab.activeForeground": "#${fg0}",
    "tab.inactiveBackground": "#${bg_caret_row}",
    "tab.inactiveForeground": "#${gray1}",
    "tab.border": "#${bg_caret_row}",
    "tab.activeBorder": "#${variable}",

    "editorGroupHeader.tabsBackground": "#${bg_caret_row}",
    "editorGroup.border": "#${bg_indent}",

    "panel.background": "#${bg_caret_row}",
    "panel.border": "#${bg_indent}",
    "panelTitle.activeForeground": "#${fg0}",
    "panelTitle.activeBorder": "#${variable}",
    "panelTitle.inactiveForeground": "#${gray1}",

    "terminal.background": "#${black}",
    "terminal.foreground": "#${fg1}",
    "terminal.ansiBlack": "#${black}",
    "terminal.ansiRed": "#${red}",
    "terminal.ansiGreen": "#${green}",
    "terminal.ansiYellow": "#${yellow}",
    "terminal.ansiBlue": "#${blue}",
    "terminal.ansiMagenta": "#${purple}",
    "terminal.ansiCyan": "#${cyan}",
    "terminal.ansiWhite": "#${fg1}",
    "terminal.ansiBrightBlack": "#${gray0}",
    "terminal.ansiBrightRed": "#${fs_deleted}",
    "terminal.ansiBrightGreen": "#${green_light}",
    "terminal.ansiBrightYellow": "#${fs_hijacked}",
    "terminal.ansiBrightBlue": "#${blue}",
    "terminal.ansiBrightMagenta": "#${fs_merged}",
    "terminal.ansiBrightCyan": "#${teal_info}",
    "terminal.ansiBrightWhite": "#${fg0}",

    "badge.background": "#${variable}",
    "badge.foreground": "#${fg0}",

    "scrollbarSlider.background": "#${bg_indent}80",
    "scrollbarSlider.hoverBackground": "#${bg_hint_border}80",
    "scrollbarSlider.activeBackground": "#${gray0}80",

    "gitDecoration.addedResourceForeground": "#${fs_added}",
    "gitDecoration.modifiedResourceForeground": "#${fs_modified}",
    "gitDecoration.deletedResourceForeground": "#${fs_deleted}",
    "gitDecoration.untrackedResourceForeground": "#${fs_added}",
    "gitDecoration.ignoredResourceForeground": "#${fs_ignored}",
    "gitDecoration.conflictingResourceForeground": "#${fs_merged_conflict}",

    "peekView.border": "#${variable}",
    "peekViewEditor.background": "#${bg_caret_row}",
    "peekViewEditor.matchHighlightBackground": "#${search_bg}",
    "peekViewResult.background": "#${bg_lookup}",
    "peekViewResult.matchHighlightBackground": "#${search_bg}",
    "peekViewTitle.background": "#${bg_lookup}",
    "peekViewTitleLabel.foreground": "#${fg0}",
    "peekViewTitleDescription.foreground": "#${gray1}",

    "minimap.findMatchHighlight": "#${search_bg}",
    "minimap.selectionHighlight": "#${selection_bg}",
    "minimap.errorHighlight": "#${red}",
    "minimap.warningHighlight": "#${yellow}",

    "breadcrumb.foreground": "#${gray1}",
    "breadcrumb.focusForeground": "#${fg0}",
    "breadcrumb.activeSelectionForeground": "#${fg0}",
    "breadcrumbPicker.background": "#${bg_lookup}"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#${comment_line}" }
    },
    {
      "scope": ["comment.block"],
      "settings": { "foreground": "#${comment_block}" }
    },
    {
      "scope": ["comment.block.documentation"],
      "settings": { "foreground": "#${comment_doc}", "fontStyle": "italic" }
    },
    {
      "scope": ["comment.block.documentation storage.type", "comment.block.documentation entity.name.type"],
      "settings": { "foreground": "#${comment_doc_tag}", "fontStyle": "bold italic" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#${keyword}" }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#${string}" }
    },
    {
      "scope": ["string.template", "punctuation.definition.template-expression"],
      "settings": { "foreground": "#${template_fg}" }
    },
    {
      "scope": ["constant.other", "variable.other.constant"],
      "settings": { "foreground": "#${purple}", "fontStyle": "italic" }
    },
    {
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#${blue}" }
    },
    {
      "scope": ["constant.language"],
      "settings": { "foreground": "#${orange}" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#${function}" }
    },
    {
      "scope": ["support.function.builtin"],
      "settings": { "foreground": "#${orange}" }
    },
    {
      "scope": ["entity.name.function.static"],
      "settings": { "foreground": "#${function_static}", "fontStyle": "italic" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type"],
      "settings": { "foreground": "#${cyan}" }
    },
    {
      "scope": ["support.type.builtin", "support.class.builtin"],
      "settings": { "foreground": "#${orange}" }
    },
    {
      "scope": ["entity.name.type.interface"],
      "settings": { "foreground": "#${cyan}", "fontStyle": "italic" }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#${variable}" }
    },
    {
      "scope": ["variable.language"],
      "settings": { "foreground": "#${orange}" }
    },
    {
      "scope": ["entity.name.namespace", "entity.name.module"],
      "settings": { "foreground": "#${green_sage}" }
    },
    {
      "scope": ["keyword.operator", "punctuation.separator"],
      "settings": { "foreground": "#${green}" }
    },
    {
      "scope": ["punctuation.delimiter", "punctuation.accessor"],
      "settings": { "foreground": "#${orange}" }
    },
    {
      "scope": ["punctuation"],
      "settings": { "foreground": "#${green}" }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#${keyword}" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#${metadata}" }
    },
    {
      "scope": ["meta.decorator", "meta.annotation"],
      "settings": { "foreground": "#${metadata}" }
    },
    {
      "scope": ["variable.other.property", "support.type.property-name"],
      "settings": { "foreground": "#${variable}" }
    },
    {
      "scope": ["entity.name.label"],
      "settings": { "foreground": "#${variable}" }
    },
    {
      "scope": ["markup.heading"],
      "settings": { "foreground": "#${teal_info}", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.strikethrough"],
      "settings": { "fontStyle": "strikethrough" }
    },
    {
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#${yellow}" }
    },
    {
      "scope": ["string.other.link"],
      "settings": { "foreground": "#${selection_fg}" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#${green_sage}" }
    },
    {
      "scope": ["markup.list"],
      "settings": { "foreground": "#${orange}" }
    },
    {
      "scope": ["markup.quote"],
      "settings": { "foreground": "#${comment_doc_tag}", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#${green_light}" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#${red}" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#${purple}" }
    }
  ]
}
