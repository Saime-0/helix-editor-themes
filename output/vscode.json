    "breadcrumb.focusForeground": "#e6e6e8",
    "breadcrumb.activeSelectionForeground": "#e6e6e8",
    "breadcrumbPicker.background": "#181818"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#38483d" }
    },
    {
      "scope": ["comment.block"],
      "settings": { "foreground": "#2d3828" }
    },
    {
      "scope": ["comment.block.documentation"],
      "settings": { "foreground": "#253423", "fontStyle": "italic" }
    },
    {
      "scope": ["comment.block.documentation storage.type", "comment.block.documentation entity.name.type"],
      "settings": { "foreground": "#638159", "fontStyle": "bold italic" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#69472c" }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#454479" }
    },
    {
      "scope": ["string.template", "punctuation.definition.template-expression"],
      "settings": { "foreground": "#33e3e3" }
    },
    {
      "scope": ["constant.other", "variable.other.constant"],
      "settings": { "foreground": "#9876AA", "fontStyle": "italic" }
    },
    {
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#6897BB" }
    },
    {
      "scope": ["constant.language"],
      "settings": { "foreground": "#CC7832" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#7c4141" }
    },
    {
      "scope": ["support.function.builtin"],
      "settings": { "foreground": "#CC7832" }
    },
    {
      "scope": ["entity.name.function.static"],
      "settings": { "foreground": "#8f7b5c", "fontStyle": "italic" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type"],
      "settings": { "foreground": "#6FAFBD" }
    },
    {
      "scope": ["support.type.builtin", "support.class.builtin"],
      "settings": { "foreground": "#CC7832" }
    },
    {
      "scope": ["entity.name.type.interface"],
      "settings": { "foreground": "#6FAFBD", "fontStyle": "italic" }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#405469" }
    },
    {
      "scope": ["variable.language"],
      "settings": { "foreground": "#CC7832" }
    },
    {
      "scope": ["entity.name.namespace", "entity.name.module"],
      "settings": { "foreground": "#AFBF7E" }
    },
    {
      "scope": ["keyword.operator", "punctuation.separator"],
      "settings": { "foreground": "#507C3B" }
    },
    {
      "scope": ["punctuation.delimiter", "punctuation.accessor"],
      "settings": { "foreground": "#CC7832" }
    },
    {
      "scope": ["punctuation"],
      "settings": { "foreground": "#507C3B" }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#69472c" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#9765b0" }
    },
    {
      "scope": ["meta.decorator", "meta.annotation"],
      "settings": { "foreground": "#9765b0" }
    },
    {
      "scope": ["variable.other.property", "support.type.property-name"],
      "settings": { "foreground": "#405469" }
    },
    {
      "scope": ["entity.name.label"],
      "settings": { "foreground": "#405469" }
    },
    {
      "scope": ["markup.heading"],
      "settings": { "foreground": "#80bcb6", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.strikethrough"],
      "settings": { "fontStyle": "strikethrough" }
    },
    {
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#dbac66" }
    },
    {
      "scope": ["string.other.link"],
      "settings": { "foreground": "#68f3ca" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#AFBF7E" }
    },
    {
      "scope": ["markup.list"],
      "settings": { "foreground": "#CC7832" }
    },
    {
      "scope": ["markup.quote"],
      "settings": { "foreground": "#638159", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#6fb593" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#cd5c60" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#9876AA" }
    }
  ]
}
