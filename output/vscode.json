    "terminal.ansiBrightBlue": "#6897BB",
    "terminal.ansiBrightMagenta": "#c792ea",
    "terminal.ansiBrightCyan": "#80bcb6",
    "terminal.ansiBrightWhite": "#e6e6e8",

