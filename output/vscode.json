    "dropdown.foreground": "#adadb9",

    "list.activeSelectionBackground": "#1e1e1e",
    "list.activeSelectionForeground": "#e6e6e8",
    "list.hoverBackground": "#151515",
    "list.focusBackground": "#1e1e1e",
    "list.highlightForeground": "#68f3ca",
    "list.errorForeground": "#cd5c60",
    "list.warningForeground": "#dbac66",

    "activityBar.background": "#0c0c0c",
    "activityBar.foreground": "#adadb9",
    "activityBarBadge.background": "#405469",
    "activityBarBadge.foreground": "#e6e6e8",

    "sideBar.background": "#0c0c0c",
    "sideBar.foreground": "#adadb9",
