{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Black Warm",
  "author": "saime-0 <acc.saime.d@gmail.com>",
  "themes": [
    {
      "name": "Black Warm",
      "appearance": "dark",
      "style": {
        "background": "#000000",
        "editor.background": "#000000",
        "editor.gutter.background": "#000000",
        "editor.line_number": "#545c5e",
        "editor.active_line_number": "#919a9c",
        "editor.active_line.background": "#0c0c0c",
        "editor.foreground": "#adadb9",
        "editor.subheader.background": "#0c0c0c",

        "cursor": "#e6e6e8",
        "selection": "#192336",

        "border": "#151515",
        "border.variant": "#1e1e1e",
        "border.focused": "#405469",
        "border.selected": "#405469",
        "border.transparent": "#00000000",
        "border.disabled": "#151515",

        "elevated_surface.background": "#0c0c0c",
        "surface.background": "#0c0c0c",
        "element.background": "#0c0c0c",
        "element.hover": "#151515",
        "element.selected": "#151515",

        "ghost_element.hover": "#151515",
        "ghost_element.selected": "#1e1e1e",

        "text": "#adadb9",
        "text.muted": "#72737a",
        "text.accent": "#68f3ca",

        "icon": "#adadb9",
        "icon.muted": "#72737a",

        "status_bar.background": "#0c0c0c",
        "title_bar.background": "#0c0c0c",
        "toolbar.background": "#000000",
        "tab_bar.background": "#0c0c0c",
        "tab.active_background": "#000000",
        "tab.inactive_background": "#0c0c0c",
        "panel.background": "#0c0c0c",

        "scrollbar.track.border": "#151515",
        "scrollbar.thumb.background": "#1e1e1e",
        "scrollbar.thumb.border": "#1e1e1e",

        "terminal.background": "#000000",
        "terminal.foreground": "#adadb9",
        "terminal.ansi.black": "#000000",
        "terminal.ansi.red": "#cd5c60",
        "terminal.ansi.green": "#507C3B",
        "terminal.ansi.yellow": "#dbac66",
        "terminal.ansi.blue": "#6897BB",
        "terminal.ansi.magenta": "#9876AA",
        "terminal.ansi.cyan": "#6FAFBD",
        "terminal.ansi.white": "#adadb9",
        "terminal.ansi.bright_black": "#545c5e",
        "terminal.ansi.bright_red": "#cd5c60",
        "terminal.ansi.bright_green": "#6fb593",
        "terminal.ansi.bright_yellow": "#dbac66",
        "terminal.ansi.bright_blue": "#6897BB",
        "terminal.ansi.bright_magenta": "#9876AA",
        "terminal.ansi.bright_cyan": "#6FAFBD",
        "terminal.ansi.bright_white": "#e6e6e8",

        "error": "#cd5c60",
        "error.background": "#cd5c6019",
        "error.border": "#cd5c60",
        "warning": "#dbac66",
        "warning.background": "#dbac6619",
        "warning.border": "#dbac66",
        "info": "#6FAFBD",
        "info.background": "#6FAFBD19",
        "info.border": "#6FAFBD",
        "hint": "#405469",
        "hint.background": "#40546919",
        "hint.border": "#405469",

        "conflict": "#dbac66",
        "created": "#6fb593",
        "deleted": "#cd5c60",
        "modified": "#9876AA",
        "renamed": "#6FAFBD",

        "players": [
          { "cursor": "#e6e6e8", "selection": "#192336", "background": "#e6e6e8" }
        ],

        "syntax": {
          "keyword": { "color": "#69472C" },
          "function": { "color": "#9e7959" },
          "type": { "color": "#6FAFBD" },
          "variable": { "color": "#405469" },
          "variable.special": { "color": "#CC7832" },
          "constant": { "color": "#9876AA" },
          "number": { "color": "#6897BB" },
          "string": { "color": "#454479" },
          "string.special": { "color": "#CC7832" },
          "comment": { "color": "#38483d" },
          "operator": { "color": "#507C3B" },
          "punctuation": { "color": "#507C3B" },
          "punctuation.delimiter": { "color": "#CC7832" },
          "label": { "color": "#405469" },
          "attribute": { "color": "#9876AA" },
          "tag": { "color": "#69472C" },
          "property": { "color": "#405469" },
          "namespace": { "color": "#AFBF7E" },
          "boolean": { "color": "#CC7832" },
          "embedded": { "color": "#CC7832" }
        }
      }
    }
  ]
}
