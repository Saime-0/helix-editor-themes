{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Black Warm",
  "version": "0.2.0",
  "author": "dsaime <acc.saime.d@gmail.com>",
  "themes": [
    {
      "name": "Black Warm",
      "appearance": "dark",
      "style": {
        "background": "#000000",
        "editor.background": "#000000",
        "editor.gutter.background": "#000000",
        "editor.line_number": "#545c5e",
        "editor.active_line_number": "#919a9c",
        "editor.active_line.background": "#0c0c0c",
        "editor.foreground": "#548b48",
        "editor.subheader.background": "#181818",

        "cursor": "#e6e6e8",
        "selection": "#0e141e",

        "border": "#1e1e1e",
        "border.variant": "#151515",
        "border.focused": "#405469",
        "border.selected": "#405469",
        "border.transparent": "#00000000",
        "border.disabled": "#1e1e1e",

        "elevated_surface.background": "#181818",
        "surface.background": "#181818",
        "element.background": "#181818",
        "element.hover": "#1e1e1e",
        "element.selected": "#1e1e1e",

        "ghost_element.hover": "#1e1e1e",
        "ghost_element.selected": "#151515",

        "text": "#548b48",
        "text.muted": "#72737a",
        "text.accent": "#68f3ca",

        "icon": "#548b48",
        "icon.muted": "#72737a",

        "status_bar.background": "#181818",
        "title_bar.background": "#181818",
        "toolbar.background": "#000000",
        "tab_bar.background": "#181818",
        "tab.active_background": "#000000",
        "tab.inactive_background": "#181818",
        "panel.background": "#181818",

        "scrollbar.track.border": "#1e1e1e",
        "scrollbar.thumb.background": "#151515",
        "scrollbar.thumb.border": "#151515",

        "terminal.background": "#000000",
        "terminal.foreground": "#adadb9",
        "terminal.ansi.black": "#000000",
        "terminal.ansi.red": "#cd5c60",
        "terminal.ansi.green": "#507C3B",
        "terminal.ansi.yellow": "#dbac66",
        "terminal.ansi.blue": "#6897BB",
        "terminal.ansi.magenta": "#9876AA",
        "terminal.ansi.cyan": "#6FAFBD",
        "terminal.ansi.white": "#adadb9",
        "terminal.ansi.bright_black": "#545c5e",
        "terminal.ansi.bright_red": "#f77669",
        "terminal.ansi.bright_green": "#6fb593",
        "terminal.ansi.bright_yellow": "#ffcb6b",
        "terminal.ansi.bright_blue": "#6897BB",
        "terminal.ansi.bright_magenta": "#c792ea",
        "terminal.ansi.bright_cyan": "#80bcb6",
        "terminal.ansi.bright_white": "#e6e6e8",

        "error": "#cd5c60",
        "error.background": "#cd5c6019",
        "error.border": "#cd5c60",
        "warning": "#dbac66",
        "warning.background": "#dbac6619",
        "warning.border": "#dbac66",
        "info": "#80bcb6",
        "info.background": "#80bcb619",
        "info.border": "#80bcb6",
        "hint": "#4d9391",
        "hint.background": "#4d939119",
        "hint.border": "#4d9391",

        "conflict": "#fc9867",
        "created": "#c3e887",
        "deleted": "#f77669",
        "modified": "#80cbc4",
        "renamed": "#80bcb6",

        "players": [
          { "cursor": "#e6e6e8", "selection": "#0e141e", "background": "#e6e6e8" }
        ],

        "syntax": {
          "keyword": { "color": "#69472c" },
          "function": { "color": "#7c4141" },
          "function.builtin": { "color": "#CC7832" },
          "function.method": { "color": "#7c4141" },
          "function.special": { "color": "#8f7b5c", "font_style": "italic" },
          "type": { "color": "#6FAFBD" },
          "type.builtin": { "color": "#CC7832" },
          "variable": { "color": "#405469" },
          "variable.special": { "color": "#CC7832" },
          "constant": { "color": "#9876AA" },
          "constant.builtin": { "color": "#CC7832" },
          "number": { "color": "#6897BB" },
          "string": { "color": "#454479" },
          "string.special": { "color": "#CC7832" },
          "comment": { "color": "#38483d" },
          "comment.doc": { "color": "#253423", "font_style": "italic" },
          "operator": { "color": "#507C3B" },
          "punctuation": { "color": "#507C3B" },
          "punctuation.delimiter": { "color": "#CC7832" },
          "label": { "color": "#405469" },
          "attribute": { "color": "#9765b0" },
          "tag": { "color": "#69472c" },
          "property": { "color": "#405469" },
          "namespace": { "color": "#AFBF7E" },
          "boolean": { "color": "#CC7832" },
          "embedded": { "color": "#33e3e3" },
          "link_uri": { "color": "#dbac66" },
          "link_text": { "color": "#68f3ca" },
          "title": { "color": "#80bcb6", "font_weight": 700 }
        }
      }
    }
  ]
}
